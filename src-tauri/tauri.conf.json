{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DBML Editor",
  "mainBinaryName": "dbml-editor",
  "version": "0.4.0",
  "identifier": "com.amkmonk.dbml-editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5177",
    "beforeDevCommand": "npm run ui:dev",
    "beforeBuildCommand": "npm run ui:build"
  },
  "app": {
    "windows": [
      {
        "title": "Редактор DBML",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Редактор DBML-диаграмм",
    "fileAssociations": [
      {
        "ext": ["dbml"],
        "name": "DBML",
        "description": "Схема DBML",
        "mimeType": "text/x-dbml",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
